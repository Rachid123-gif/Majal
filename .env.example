# Copiez ce fichier en `.env` (fait automatiquement par `make setup`).
# Ne mettez JAMAIS de vraie valeur secrète dans .env.example : il est versionné.

APP_ENV=development

# Base de données (locale, dans Docker)
POSTGRES_USER=majal
POSTGRES_PASSWORD=majal
POSTGRES_DB=majal
# Utilisé seulement quand le backend tourne hors Docker :
DATABASE_URL=postgresql+psycopg://majal:majal@localhost:5432/majal

# Adresse du backend vue par le frontend (hors Docker ; dans Docker : http://backend:8000)
BACKEND_INTERNAL_URL=http://localhost:8000

# Intelligence artificielle (étape 3)
# Mode souverain : aucun appel à un service extérieur pendant l'utilisation (par défaut).
SOVEREIGN_MODE=true
# Fournisseur : ollama (IA locale sur le Mac), anthropic (désactivé en mode souverain), none (sans IA)
LLM_PROVIDER=ollama
# Ollama tourne sur le Mac, hors Docker (accès à la puce graphique).
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
# Modèle de repli si le principal n'est pas installé (banc d'essai : docs/benchmarks/).
OLLAMA_FALLBACK_MODEL=gemma3:4b
# Clé Anthropic : seulement si SOVEREIGN_MODE=false. À ne jamais partager ni committer.
ANTHROPIC_API_KEY=

# Connexion (étape 0 bis)
# Secret qui signe les sessions : une longue valeur aléatoire, propre à chaque machine.
SESSION_SECRET=
# Mots de passe des deux comptes de démonstration. Vide = compte désactivé.
DEMO_PROFESSEUR_PASSWORD=
DEMO_PRESENTATEUR_PASSWORD=
